# Server-side secrets for the submit-inquiry Edge Function.
# Copy to supabase/functions/.env for `supabase functions serve`, or set with
# `supabase secrets set` for the deployed function. Do not commit real values.
SITE_ORIGIN=http://localhost:5173
# Optional email notifications (Resend). Leave empty to store inquiries only.
RESEND_API_KEY=
INQUIRY_RECIPIENT=
INQUIRY_FROM=
