# Browser-visible Supabase configuration.
# Copy to `.env.local` and fill in from Supabase -> Project Settings -> API.
# The anon key is designed to be public; never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public link to a Calendly or Google appointment schedule.
# When set, the main call-to-action opens available times; otherwise it opens the inquiry form.
VITE_BOOKING_URL=
